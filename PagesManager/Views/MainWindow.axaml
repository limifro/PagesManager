<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PagesManager.Core.ViewModels;assembly=PagesManager.Core"
        xmlns:conv="clr-namespace:PagesManager.Converters"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="PagesManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Title="Pages Manager"
        Background="{DynamicResource EditorBackground}">

    <Window.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
        <conv:BoolToPinTextConverter x:Key="BoolToPinText"/>
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <conv:BoolToFontStyleConverter x:Key="BoolToFontStyle"/>
        <conv:StringToTextAlignmentConverter x:Key="StringToTextAlignment"/>
        <conv:StringToFontFamilyConverter x:Key="StringToFontFamily"/>
        <conv:BoolToThemeIconConverter x:Key="BoolToThemeIcon"/>
    </Window.Resources>

    <Grid ColumnDefinitions="300,*" Name="RootGrid">

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerColor}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12">

                <Grid DockPanel.Dock="Top" Margin="4,4,4,12" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Заметки"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="Переключить тему"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Content="{Binding IsDarkTheme, Converter={StaticResource BoolToThemeIcon}}"/>
                </Grid>

                <Button DockPanel.Dock="Top"
                        Classes="accent"
                        Content="＋  Новая заметка"
                        Command="{Binding NoteList.CreateNoteCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,10"/>
                <TextBox DockPanel.Dock="Top"
                         Classes="search"
                         PlaceholderText="Поиск..."
                         Text="{Binding NoteList.SearchQuery, Mode=TwoWay}"
                         Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding NoteList.Notes}"
                         SelectedItem="{Binding NoteList.SelectedNote, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:NoteListItemViewModel">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding PinText}"
                                               FontSize="12"
                                               IsVisible="{Binding IsPinned}"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding UpdatedAtDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBlock Text="{Binding Preview}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource EditorBackground}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="{Binding !NoteEditor.HasNote}">
                <TextBlock Text="📝"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           Opacity="0.3"/>
                <TextBlock Text="Выберите заметку"
                           FontSize="18"
                           Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="или создайте новую"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center"
                           Opacity="0.7"/>
            </StackPanel>

            <DockPanel IsVisible="{Binding NoteEditor.HasNote}" Margin="32,20">

                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource DividerColor}"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Сохранить"
                                Command="{Binding NoteEditor.SaveCommand}"/>
                        <Button Content="Удалить"
                                Command="{Binding NoteEditor.DeleteCommand}"/>
                        <Button Command="{Binding NoteEditor.TogglePinCommand}"
                                Content="{Binding NoteEditor.IsPinned, Converter={StaticResource BoolToPinText}}"/>
                        <Button Content="Прикрепить фото"
                                Command="{Binding NoteEditor.AttachImageCommand}"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource ToolbarBackground}"
                        BorderBrush="{DynamicResource ToolbarBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="160"
                                  ItemsSource="{Binding NoteEditor.AvailableFonts}"
                                  SelectedItem="{Binding NoteEditor.FontFamily, Mode=TwoWay}"
                                  ToolTip.Tip="Шрифт"/>
                        <ComboBox Width="70"
                                  ItemsSource="{Binding NoteEditor.AvailableFontSizes}"
                                  SelectedItem="{Binding NoteEditor.FontSize, Mode=TwoWay}"
                                  ToolTip.Tip="Размер"/>
                        <Border Width="1" Background="{DynamicResource DividerColor}" Margin="6,2"/>
                        <ToggleButton IsChecked="{Binding NoteEditor.IsBold, Mode=TwoWay}"
                                      ToolTip.Tip="Жирный">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="14"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding NoteEditor.IsItalic, Mode=TwoWay}"
                                      ToolTip.Tip="Курсив">
                            <TextBlock Text="I" FontStyle="Italic" FontSize="14"/>
                        </ToggleButton>
                        <Border Width="1" Background="{DynamicResource DividerColor}" Margin="6,2"/>
                        <Button Classes="toolbar"
                                Command="{Binding NoteEditor.AlignLeftCommand}"
                                ToolTip.Tip="По левому краю"
                                Content="←"/>
                        <Button Classes="toolbar"
                                Command="{Binding NoteEditor.AlignCenterCommand}"
                                ToolTip.Tip="По центру"
                                Content="⏏︎"/>
                        <Button Classes="toolbar"
                                Command="{Binding NoteEditor.AlignRightCommand}"
                                ToolTip.Tip="По правому краю"
                                Content="→"/>
                    </StackPanel>
                </Border>

                <TextBox DockPanel.Dock="Top"
                         Classes="title"
                         Text="{Binding NoteEditor.Title, Mode=TwoWay}"
                         PlaceholderText="Заголовок"
                         Margin="0,18,0,4"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="0,8,0,16">
                        <ItemsControl ItemsSource="{Binding NoteEditor.Attachments}"
                                      IsVisible="{Binding NoteEditor.Attachments.Count}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:AttachmentViewModel">
                                    <Border Margin="0,0,10,10"
                                            CornerRadius="10"
                                            ClipToBounds="True"
                                            BorderBrush="{DynamicResource DividerColor}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ToolbarBackground}">
                                        <Grid Width="180" Height="180">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    CornerRadius="0"
                                                    Command="{Binding #RootGrid.((vm:MainWindowViewModel)DataContext).NoteEditor.OpenAttachmentPreviewCommand}"
                                                    CommandParameter="{Binding}">
                                                <Image Source="{Binding FilePath, Converter={StaticResource PathToBitmap}}"
                                                       Stretch="UniformToFill"/>
                                            </Button>
                                            <Button Content="✕"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Padding="6,2"
                                                    Background="#AA000000"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="12"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Command="{Binding #RootGrid.((vm:MainWindowViewModel)DataContext).NoteEditor.RemoveAttachmentCommand}"
                                                    CommandParameter="{Binding}"
                                                    ZIndex="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Classes="content"
                                 Text="{Binding NoteEditor.Content, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontSize="{Binding NoteEditor.FontSize}"
                                 FontFamily="{Binding NoteEditor.FontFamily, Converter={StaticResource StringToFontFamily}}"
                                 FontWeight="{Binding NoteEditor.IsBold, Converter={StaticResource BoolToFontWeight}}"
                                 FontStyle="{Binding NoteEditor.IsItalic, Converter={StaticResource BoolToFontStyle}}"
                                 TextAlignment="{Binding NoteEditor.TextAlignment, Converter={StaticResource StringToTextAlignment}}"
                                 PlaceholderText="Начните писать..."
                                 MinHeight="300"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Grid>
    </Grid>
</Window>