<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PagesManager.Core.ViewModels;assembly=PagesManager.Core"
        xmlns:conv="clr-namespace:PagesManager.Converters"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="PagesManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        Title="Pages Manager">

    <Window.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
        <conv:BoolToPinTextConverter x:Key="BoolToPinText"/>
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <conv:BoolToFontStyleConverter x:Key="BoolToFontStyle"/>
        <conv:StringToTextAlignmentConverter x:Key="StringToTextAlignment"/>
        <conv:StringToFontFamilyConverter x:Key="StringToFontFamily"/>
    </Window.Resources>

    <Grid ColumnDefinitions="280,*" Name="RootGrid">

        <Border Grid.Column="0" Background="#F4F4F6" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="Заметки" FontSize="20" FontWeight="Bold"/>
                    <Button Content="+ Новая заметка"
                            Command="{Binding NoteList.CreateNoteCommand}"
                            HorizontalAlignment="Stretch"/>
                    <TextBox PlaceholderText="Поиск..."
                             Text="{Binding NoteList.SearchQuery, Mode=TwoWay}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding NoteList.Notes}"
                         SelectedItem="{Binding NoteList.SelectedNote, Mode=TwoWay}"
                         Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:NoteListItemViewModel">
                            <StackPanel Spacing="2" Margin="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding PinText}"
                                               FontSize="14"
                                               IsVisible="{Binding IsPinned}"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="15"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding UpdatedAtDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#444"/>
                                    <TextBlock Text="{Binding Preview}"
                                               FontSize="12"
                                               Foreground="Gray"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Padding="16">
            <DockPanel IsVisible="{Binding NoteEditor.HasNote}">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                    <Button Content="Сохранить" Command="{Binding NoteEditor.SaveCommand}"/>
                    <Button Content="Удалить" Command="{Binding NoteEditor.DeleteCommand}"/>
                    <Button Command="{Binding NoteEditor.TogglePinCommand}"
                            Content="{Binding NoteEditor.IsPinned, Converter={StaticResource BoolToPinText}}"/>
                    <Button Content="Прикрепить" Command="{Binding NoteEditor.AttachImageCommand}"/>
                </StackPanel>

                <Border DockPanel.Dock="Top"
                        Background="#FAFAFA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <ComboBox Width="160"
                                  ItemsSource="{Binding NoteEditor.AvailableFonts}"
                                  SelectedItem="{Binding NoteEditor.FontFamily, Mode=TwoWay}"
                                  ToolTip.Tip="Шрифт"/>

                        <ComboBox Width="70"
                                  ItemsSource="{Binding NoteEditor.AvailableFontSizes}"
                                  SelectedItem="{Binding NoteEditor.FontSize, Mode=TwoWay}"
                                  ToolTip.Tip="Размер"/>

                        <Border Width="1" Background="#DDD" Margin="4,0"/>

                        <ToggleButton IsChecked="{Binding NoteEditor.IsBold, Mode=TwoWay}"
                                      ToolTip.Tip="Жирный"
                                      HorizontalContentAlignment="Center"
                                      MinWidth="36">
                            <TextBlock Text="B" FontWeight="Bold"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding NoteEditor.IsItalic, Mode=TwoWay}"
                                      ToolTip.Tip="Курсив"
                                      HorizontalContentAlignment="Center"
                                      MinWidth="36">
                            <TextBlock Text="I" FontStyle="Italic"/>
                        </ToggleButton>

                        <Border Width="1" Background="#DDD" Margin="4,0"/>

                        <Button Command="{Binding NoteEditor.AlignLeftCommand}"
                                ToolTip.Tip="По левому краю"
                                HorizontalContentAlignment="Center"
                                MinWidth="36"
                                Content="⇤"/>
                        <Button Command="{Binding NoteEditor.AlignCenterCommand}"
                                ToolTip.Tip="По центру"
                                MinWidth="36"
                                HorizontalContentAlignment="Center"
                                Content="⏏︎"/>
                        <Button Command="{Binding NoteEditor.AlignRightCommand}"
                                ToolTip.Tip="По правому краю"
                                HorizontalContentAlignment="Center"
                                MinWidth="36"
                                Content="⇥"/>
                    </StackPanel>
                </Border>

                <TextBox DockPanel.Dock="Top"
                         Text="{Binding NoteEditor.Title, Mode=TwoWay}"
                         FontSize="22" FontWeight="Bold"
                         PlaceholderText="Заголовок"
                         Margin="0,12,0,8"
                         BorderThickness="0"
                         Background="Transparent"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <ItemsControl ItemsSource="{Binding NoteEditor.Attachments}"
                                      IsVisible="{Binding NoteEditor.Attachments.Count}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:AttachmentViewModel">
                                    <Border Margin="0,0,8,8"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1">
                                        <Grid Width="180" Height="180">

                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Command="{Binding #RootGrid.((vm:MainWindowViewModel)DataContext).NoteEditor.OpenAttachmentPreviewCommand}"
                                                    CommandParameter="{Binding}">
                                                <Image Source="{Binding FilePath, Converter={StaticResource PathToBitmap}}"
                                                       Stretch="UniformToFill"/>
                                            </Button>

                                            <Button Content="✕"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Padding="6,2"
                                                    Background="#AA000000"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Command="{Binding #RootGrid.((vm:MainWindowViewModel)DataContext).NoteEditor.RemoveAttachmentCommand}"
                                                    CommandParameter="{Binding}"
                                                    ZIndex="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Text="{Binding NoteEditor.Content, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontSize="{Binding NoteEditor.FontSize}"
                                 FontFamily="{Binding NoteEditor.FontFamily, Converter={StaticResource StringToFontFamily}}"
                                 FontWeight="{Binding NoteEditor.IsBold, Converter={StaticResource BoolToFontWeight}}"
                                 FontStyle="{Binding NoteEditor.IsItalic, Converter={StaticResource BoolToFontStyle}}"
                                 TextAlignment="{Binding NoteEditor.TextAlignment, Converter={StaticResource StringToTextAlignment}}"
                                 PlaceholderText="Начните писать..."
                                 MinHeight="200"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Grid>
</Window>