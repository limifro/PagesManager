<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PagesManager.Core.ViewModels;assembly=PagesManager.Core"
        xmlns:conv="clr-namespace:PagesManager.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="PagesManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="650"
        Title="Pages Manager">

    <Window.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
    </Window.Resources>

    <Grid ColumnDefinitions="280,*" Name="RootGrid">
        <Border Grid.Column="0" Background="#F4F4F6" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="Заметки" FontSize="20" FontWeight="Bold"/>
                    <Button Content="+ Новая заметка"
                            Command="{Binding NoteList.CreateNoteCommand}"
                            HorizontalAlignment="Stretch"/>
                    <TextBox PlaceholderText="Поиск..."
                             Text="{Binding NoteList.SearchQuery, Mode=TwoWay}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding NoteList.Notes}"
                         SelectedItem="{Binding NoteList.SelectedNote, Mode=TwoWay}"
                         Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:NoteListItemViewModel">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="📌"
                                               IsVisible="{Binding IsPinned}"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Preview}"
                                           FontSize="12"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Padding="16">
            <DockPanel IsVisible="{Binding NoteEditor.HasNote}">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                    <Button Content="Сохранить" Command="{Binding NoteEditor.SaveCommand}"/>
                    <Button Content="Удалить" Command="{Binding NoteEditor.DeleteCommand}"/>
                    <Button Content="📌" Command="{Binding NoteEditor.TogglePinCommand}"/>
                    <Button Content="Прикрепить фото" Command="{Binding NoteEditor.AttachImageCommand}"/>
                </StackPanel>

                <TextBox DockPanel.Dock="Top"
                         Text="{Binding NoteEditor.Title, Mode=TwoWay}"
                         FontSize="20" FontWeight="Bold"
                         PlaceholderText="Заголовок"
                         Margin="0,12,0,8"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <ItemsControl ItemsSource="{Binding NoteEditor.Attachments}"
                                      IsVisible="{Binding NoteEditor.Attachments.Count}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:AttachmentViewModel">
                                    <Border Margin="0,0,8,8"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1">
                                        <Grid Width="180" Height="180">
                                            <Image Source="{Binding FilePath, Converter={StaticResource PathToBitmap}}"
                                                   Stretch="UniformToFill"/>
                                            <Button Content="✕"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="4"
                                                    Padding="6,2"
                                                    Background="#80000000"
                                                    Foreground="White"
                                                    CornerRadius="12"
                                                    Command="{Binding #RootGrid.((vm:MainWindowViewModel)DataContext).NoteEditor.RemoveAttachmentCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Text="{Binding NoteEditor.Content, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontSize="{Binding NoteEditor.FontSize}"
                                 PlaceholderText="Начните писать..."
                                 MinHeight="200"
                                 BorderThickness="0"
                                 Background="Transparent"/>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Grid>
</Window>