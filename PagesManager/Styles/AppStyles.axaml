<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <SolidColorBrush x:Key="SidebarBackground" Color="#FBF7E8"/>
        <SolidColorBrush x:Key="EditorBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#E5A93D"/>
        <SolidColorBrush x:Key="AccentColorLight" Color="#F5E6B8"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8A8A8E"/>
        <SolidColorBrush x:Key="DividerColor" Color="#EFEAD8"/>
        <SolidColorBrush x:Key="ToolbarBackground" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="ToolbarBorder" Color="#E8E8E8"/>
    </Styles.Resources>

    <Style Selector="Button">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F0EBD8"/>
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#E8E0C5"/>
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource AccentColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Button.accent /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentColor}"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#D49832"/>
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#C18620"/>
    </Style>

    <Style Selector="Button.toolbar">
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="36"/>
    </Style>

    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F0EBD8"/>
    </Style>

    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentColorLight}"/>
    </Style>

    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#EBD894"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBox.title">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style Selector="TextBox.title:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox.content">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style Selector="TextBox.content:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox.content:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F0EBD8"/>
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentColorLight}"/>
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#EBD894"/>
    </Style>

    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentColorLight}"/>
    </Style>

</Styles>